# Copy this file to .env for local development.
ENV=dev
NEWS_API_KEY=
FRED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Optional background trainer settings
RUN_TRAINER_SCHEDULER=0
INTERNAL_SYNC_TOKEN=
PREDIQT_API_URL=

# Paper-only broker execution. Live trading is intentionally not wired.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
AUTOMATION_MAX_NOTIONAL=100
ALPHA_VANTAGE_API_KEY=

# Optional durable forecast ledger location (defaults to data/kingmaker.sqlite3).
# KINGMAKER_LEDGER_PATH=/persistent-disk/kingmaker.sqlite3
